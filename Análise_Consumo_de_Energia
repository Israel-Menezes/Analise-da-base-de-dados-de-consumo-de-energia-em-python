      "source": [
        "mensal = (dados.groupby(\"mes\", as_index=False)\n",
        "          .agg(referencia=(\"media_consumo_mes_2018_2019\", \"sum\"),\n",
        "               consumo=(\"consumo_mes_referencia\", \"sum\"),\n",
        "               quantidade_registros=(\"sigla_orgao\", \"count\")))\n",
        "mensal[\"reducao_pct\"] = (mensal[\"referencia\"] - mensal[\"consumo\"]) / mensal[\"referencia\"] * 100\n",
        "mensal = mensal.sort_values(\"mes\")\n",
        "mensal[\"mes_label\"] = mensal[\"mes\"].dt.strftime(\"%b/%Y\")\n",
        "mensal"
      ]
