      "source": [
        "medias_instituicao = completas.groupby(\"sigla_orgao\")[colunas_consumo].mean()\n",
        "diferencas = medias_instituicao[\"media_consumo_mes_2018_2019\"] - medias_instituicao[\"consumo_mes_referencia\"]\n",
        "\n",
        "# Teste t pareado unilateral: referência > consumo observado\n",
        "t_teste = stats.ttest_rel(\n",
        "    medias_instituicao[\"media_consumo_mes_2018_2019\"],\n",
        "    medias_instituicao[\"consumo_mes_referencia\"],\n",
        "    alternative=\"greater\"\n",
        ")\n",
        "\n",
        "# Teste de Wilcoxon pareado unilateral como análise de sensibilidade\n",
        "w_teste = stats.wilcoxon(\n",
        "    medias_instituicao[\"media_consumo_mes_2018_2019\"],\n",
        "    medias_instituicao[\"consumo_mes_referencia\"],\n",
        "    alternative=\"greater\"\n",
        ")\n",
        "\n",
        "alpha = 0.05\n",
        "print(f\"Instituições no teste: {len(medias_instituicao)}\")\n",
        "print(f\"Diferença média (referência - consumo): {diferencas.mean():,.2f}\")\n",
        "print(f\"t = {t_teste.statistic:.4f}; p-valor unilateral = {t_teste.pvalue:.6g}\")\n",
        "print(f\"Wilcoxon: estatística = {w_teste.statistic:.4f}; p-valor unilateral = {w_teste.pvalue:.6g}\")\n",
        "if t_teste.pvalue < alpha:\n",
        "    print(\"Decisão: rejeitar H₀ a 5%. Evidência estatística de consumo médio menor que a referência no grupo analisado.\")\n",
        "else:\n",
        "    print(\"Decisão: não rejeitar H₀ a 5%. Evidência insuficiente para concluir consumo médio menor que a referência.\")"
